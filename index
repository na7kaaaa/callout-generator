<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>コールアウト・ジェネレーター</title>
<style>
  :root{
    --bg: #14161c;
    --panel: #1b1e27;
    --panel-2: #21242f;
    --line: #2a2e3a;
    --ink: #eef0f5;
    --ink-dim: #8b93a7;
    --accent: #7c93f5;
    --accent-dim: #4a5580;
    --mono: "JetBrains Mono", "SFMono-Regular", Consolas, monospace;
  }

  *{ box-sizing: border-box; }

  body{
    margin:0;
    background: var(--bg);
    color: var(--ink);
    font-family: "Zen Kaku Gothic New", "Hiragino Sans", "Yu Gothic", sans-serif;
    min-height:100vh;
  }

  .wrap{
    max-width: 1080px;
    margin: 0 auto;
    padding: 40px 24px 64px;
  }

  header{
    margin-bottom: 32px;
  }
  header h1{
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.01em;
    margin: 0 0 6px;
  }
  header p{
    color: var(--ink-dim);
    font-size: 13.5px;
    margin: 0;
    line-height: 1.7;
  }

  .grid{
    display:grid;
    grid-template-columns: 340px 1fr;
    gap: 20px;
    align-items:start;
  }
  @media (max-width: 800px){
    .grid{ grid-template-columns: 1fr; }
  }

  .panel{
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 20px;
  }

  .section-title{
    font-size: 11.5px;
    color: var(--ink-dim);
    margin: 0 0 12px;
    font-weight: 600;
  }
  .section-title:not(:first-child){ margin-top: 22px; }

  .row{
    display:flex;
    align-items:center;
    gap:10px;
    margin-bottom:10px;
  }
  .row label{
    flex: 0 0 78px;
    font-size: 12.5px;
    color: var(--ink-dim);
  }
  .row input[type="text"]{
    flex:1;
    background: var(--panel-2);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 7px 10px;
    color: var(--ink);
    font-family: var(--mono);
    font-size: 12.5px;
  }
  .row input[type="color"]{
    width: 34px;
    height: 30px;
    padding:0;
    border:1px solid var(--line);
    border-radius: 8px;
    background: none;
    cursor:pointer;
  }
  .row input[type="range"]{
    flex:1;
    accent-color: var(--accent);
  }
  .row .val{
    width: 40px;
    text-align:right;
    font-size: 12px;
    color: var(--ink-dim);
    font-family: var(--mono);
  }
  .row textarea{
    flex:1;
    background: var(--panel-2);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 7px 10px;
    color: var(--ink);
    font-size: 13px;
    font-family: inherit;
    resize: vertical;
    min-height: 40px;
  }

  .toggle-row{
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-bottom: 10px;
  }
  .toggle-row span{ font-size: 12.5px; color: var(--ink-dim); }
  .switch{
    position:relative;
    width: 36px;
    height: 20px;
  }
  .switch input{ opacity:0; width:0; height:0; }
  .slider-toggle{
    position:absolute; inset:0;
    background: var(--panel-2);
    border: 1px solid var(--line);
    border-radius: 999px;
    cursor:pointer;
    transition: 0.15s;
  }
  .slider-toggle::before{
    content:"";
    position:absolute;
    width:14px; height:14px;
    left:2px; top:2px;
    background: var(--ink-dim);
    border-radius:50%;
    transition: 0.15s;
  }
  .switch input:checked + .slider-toggle{ background: var(--accent-dim); border-color: var(--accent); }
  .switch input:checked + .slider-toggle::before{ transform: translateX(16px); background: var(--accent); }

  .presets{
    display:flex;
    gap:8px;
    flex-wrap:wrap;
    margin-bottom: 14px;
  }
  .preset-chip{
    width: 26px; height:26px;
    border-radius: 50%;
    border: 1px solid var(--line);
    cursor:pointer;
    padding:0;
  }
  .preset-chip:hover{ outline: 2px solid var(--accent); outline-offset: 2px; }

  .preview-stage{
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 28px;
  }
  .preview-stage .note{
    font-size: 12px;
    color: var(--ink-dim);
    margin: 0 0 18px;
  }

  #calloutPreview{
    display:flex;
    gap: 12px;
    align-items:flex-start;
  }
  #calloutPreview .icon{
    font-size: 20px;
    line-height:1;
    flex-shrink:0;
  }
  #calloutPreview .body b{
    display:block;
    margin-bottom: 4px;
  }
  #calloutPreview .body p{
    margin:0;
    line-height:1.7;
    opacity: 0.92;
  }

  .code-block{
    margin-top: 22px;
  }
  .code-block-head{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom: 8px;
  }
  .code-block-head span{
    font-size: 11.5px;
    color: var(--ink-dim);
    font-weight:600;
  }
  .copy-btn{
    background: var(--accent-dim);
    color: var(--ink);
    border: 1px solid var(--accent);
    border-radius: 7px;
    padding: 5px 12px;
    font-size: 12px;
    cursor:pointer;
  }
  .copy-btn:hover{ background: var(--accent); }
  .copy-btn:active{ transform: translateY(1px); }

  textarea#codeOut{
    width:100%;
    height: 150px;
    background: #0f1116;
    color: #b7c1e0;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 12px;
    font-family: var(--mono);
    font-size: 11.5px;
    line-height:1.6;
    resize: vertical;
  }

  .steps{
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }
  .steps ol{
    margin:0;
    padding-left: 18px;
    color: var(--ink-dim);
    font-size: 12.5px;
    line-height: 2;
  }
  .steps ol b{ color: var(--ink); }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>コールアウト・ジェネレーター</h1>
    <p>色・アイコン・文章を決めると、右側にNotion風コールアウトのプレビューと埋め込み用コードが出てくるよ。<br>コードをGitHub Pagesに置いて、Notionの「埋め込み」ブロックにURLを貼れば完成。</p>
  </header>

  <div class="grid">
    <div class="panel">
      <p class="section-title">よく使う色</p>
      <div class="presets" id="presets"></div>

      <p class="section-title">カラー</p>
      <div class="row">
        <label>背景</label>
        <input type="color" id="bgColorPicker" value="#2b2f3d">
        <input type="text" id="bgColorText" value="#2b2f3d">
      </div>
      <div class="row">
        <label>文字</label>
        <input type="color" id="textColorPicker" value="#eef0f5">
        <input type="text" id="textColorText" value="#eef0f5">
      </div>
      <div class="row">
        <label>枠線</label>
        <input type="color" id="borderColorPicker" value="#7c93f5">
        <input type="text" id="borderColorText" value="#7c93f5">
      </div>

      <p class="section-title">枠線・角丸</p>
      <div class="toggle-row">
        <span>枠線を表示</span>
        <label class="switch">
          <input type="checkbox" id="borderToggle" checked>
          <span class="slider-toggle"></span>
        </label>
      </div>
      <div class="row">
        <label>太さ</label>
        <input type="range" id="borderWidth" min="0" max="8" value="2">
        <span class="val" id="borderWidthVal">2px</span>
      </div>
      <div class="row">
        <label>角丸</label>
        <input type="range" id="radius" min="0" max="32" value="10">
        <span class="val" id="radiusVal">10px</span>
      </div>
      <div class="row">
        <label>余白</label>
        <input type="range" id="padding" min="8" max="32" value="16">
        <span class="val" id="paddingVal">16px</span>
      </div>

      <p class="section-title">内容</p>
      <div class="row">
        <label>アイコン</label>
        <input type="text" id="iconInput" value="💡" maxlength="4">
      </div>
      <div class="row">
        <label>見出し</label>
        <textarea id="titleInput" rows="1">メモ</textarea>
      </div>
      <div class="row">
        <label>本文</label>
        <textarea id="bodyInput" rows="3">ここに説明文を入れてね。</textarea>
      </div>
    </div>

    <div>
      <div class="preview-stage">
        <p class="note">プレビュー</p>
        <div id="calloutPreview">
          <div class="icon" id="pIcon">💡</div>
          <div class="body">
            <b id="pTitle">メモ</b>
            <p id="pBody">ここに説明文を入れてね。</p>
          </div>
        </div>

        <div class="code-block">
          <div class="code-block-head">
            <span>埋め込み用コード（GitHub Pages用HTML）</span>
            <button class="copy-btn" id="copyBtn">コピー</button>
          </div>
          <textarea id="codeOut" readonly></textarea>
        </div>

        <div class="steps">
          <ol>
            <li>上のコードを丸ごとコピーして、<b>index.html</b> として保存</li>
            <li>GitHubリポジトリにpush → <b>Settings → Pages</b> で公開</li>
            <li>公開されたURLをコピー</li>
            <li>Notionで <b>/埋め込み</b>（Embed）ブロックを追加してURLを貼り付け</li>
          </ol>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
const $ = id => document.getElementById(id);

const presetColors = ["#7c93f5","#f5a97c","#f57c9c","#7cf5c4","#e8d97c","#c17cf5","#7ce0f5","#f57c7c"];
const presetsEl = $("presets");
presetColors.forEach(hex=>{
  const b = document.createElement("button");
  b.className = "preset-chip";
  b.style.background = hex;
  b.title = hex;
  b.addEventListener("click", ()=>{
    setColor("border", hex);
  });
  presetsEl.appendChild(b);
});

function syncPair(pickerId, textId, key){
  const picker = $(pickerId), text = $(textId);
  picker.addEventListener("input", ()=>{ text.value = picker.value; render(); });
  text.addEventListener("input", ()=>{
    let v = text.value.trim();
    if(/^#[0-9a-fA-F]{6}$/.test(v)){ picker.value = v; render(); }
  });
}
syncPair("bgColorPicker","bgColorText");
syncPair("textColorPicker","textColorText");
syncPair("borderColorPicker","borderColorText");

function setColor(which, hex){
  if(which==="border"){ $("borderColorPicker").value = hex; $("borderColorText").value = hex; }
  render();
}

["borderWidth","radius","padding"].forEach(id=>{
  $(id).addEventListener("input", render);
});
$("borderToggle").addEventListener("change", render);
$("iconInput").addEventListener("input", render);
$("titleInput").addEventListener("input", render);
$("bodyInput").addEventListener("input", render);

function esc(str){
  return str.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
}

function render(){
  const bg = $("bgColorText").value;
  const text = $("textColorText").value;
  const border = $("borderColorText").value;
  const hasBorder = $("borderToggle").checked;
  const bw = $("borderWidth").value;
  const radius = $("radius").value;
  const pad = $("padding").value;
  const icon = $("iconInput").value || "💡";
  const title = $("titleInput").value;
  const body = $("bodyInput").value;

  $("borderWidthVal").textContent = bw + "px";
  $("radiusVal").textContent = radius + "px";
  $("paddingVal").textContent = pad + "px";

  const preview = $("calloutPreview");
  preview.style.background = bg;
  preview.style.color = text;
  preview.style.border = hasBorder ? `${bw}px solid ${border}` : "none";
  preview.style.borderRadius = radius + "px";
  preview.style.padding = pad + "px";

  $("pIcon").textContent = icon;
  $("pTitle").textContent = title;
  $("pBody").textContent = body;

  const borderCss = hasBorder ? `border: ${bw}px solid ${border};` : "border: none;";

  const code = `<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
  html,body{ margin:0; padding:0; background:transparent; }
  .callout{
    display:flex;
    gap:12px;
    align-items:flex-start;
    background: ${bg};
    color: ${text};
    ${borderCss}
    border-radius: ${radius}px;
    padding: ${pad}px;
    font-family: "Hiragino Sans","Yu Gothic",sans-serif;
    box-sizing: border-box;
  }
  .callout .icon{ font-size:20px; line-height:1; flex-shrink:0; }
  .callout b{ display:block; margin-bottom:4px; }
  .callout p{ margin:0; line-height:1.7; }
</style>
</head>
<body>
  <div class="callout">
    <div class="icon">${icon}</div>
    <div>
      <b>${esc(title)}</b>
      <p>${esc(body)}</p>
    </div>
  </div>
</body>
</html>`;

  $("codeOut").value = code;
}

$("copyBtn").addEventListener("click", ()=>{
  $("codeOut").select();
  document.execCommand("copy");
  const btn = $("copyBtn");
  const original = btn.textContent;
  btn.textContent = "コピーしたよ";
  setTimeout(()=>{ btn.textContent = original; }, 1400);
});

render();
</script>
</body>
</html>
